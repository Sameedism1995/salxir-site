# Storefront configuration (optional).
# All are NEXT_PUBLIC_* because the storefront runs client-side, exactly like
# the original site. If unset, the app falls back to the original public values,
# so it works with no configuration. Set these in Vercel or .env.local to point
# at your own Supabase project / Stripe price.

# Store catalog + Stripe checkout (Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reviews + business-inquiry (Salxir tools Supabase project)
NEXT_PUBLIC_REVIEWS_URL=
NEXT_PUBLIC_REVIEWS_ANON_KEY=

# Single Stripe price id used at checkout
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX).
# Leave empty in dev/preview: analytics is fully disabled when this is unset,
# so only production traffic reaches the GA4 property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel id. Loads only after the visitor accepts marketing
# cookies -- the Pixel has no Consent Mode equivalent, so refusal is honoured by
# never fetching the script.
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity project id. Loads only after the visitor accepts analytics
# cookies, for the same reason.
NEXT_PUBLIC_CLARITY_ID=
